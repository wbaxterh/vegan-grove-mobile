{
  "name": "vegan-grove-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check:prod": "bash scripts/check-prod-ready.sh",
    "validate": "npm run lint && npm run typecheck && npm run check:prod",
    "assets:brand": "node scripts/gen-brand-assets.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@tanstack/react-query": "^5.106.1",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.23",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.30",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~2.33.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "13.17.0",
    "react-native-worklets": "0.13.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "~19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "secretlint": "^13.1.0",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": "biome check --write",
    "*": "secretlint"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
