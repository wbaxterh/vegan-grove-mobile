ios/
android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
.env*
!.env.example
secrets/
*.tsbuildinfo
.husky/_/

# Not needed on the build server
.git/
.github/
.vscode/
.husky/
